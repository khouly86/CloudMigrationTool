@model IEnumerable<CloudMigrationTool.Core.Entities.AppSettings>
@{
    ViewData["Title"] = "Application Settings";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>
                <i class="fas fa-cog"></i>
                Application Settings
            </h1>
            <button class="btn btn-outline-primary" onclick="refreshSettings()">
                <i class="fas fa-sync"></i> Refresh
            </button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Configuration Settings</h5>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Setting Key</th>
                                    <th>Value</th>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var setting in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@setting.Key</strong>
                                        </td>
                                        <td>
                                            @if (setting.IsEncrypted)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-lock"></i> Encrypted
                                                </span>
                                            }
                                            else
                                            {
                                                <code>@(setting.Value.Length > 50 ? setting.Value.Substring(0, 50) + "..." : setting.Value)</code>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(setting.Category))
                                            {
                                                <span class="badge bg-info">@setting.Category</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Uncategorized</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-muted">@(setting.Description ?? "No description")</span>
                                        </td>
                                        <td>
                                            @if (!setting.IsReadOnly)
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary edit-setting" 
                                                            data-id="@setting.Id" 
                                                            data-key="@setting.Key" 
                                                            data-value="@setting.Value"
                                                            title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger delete-setting" 
                                                            data-id="@setting.Id" 
                                                            data-key="@setting.Key"
                                                            title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Read Only</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-cog fa-3x text-muted mb-3"></i>
                        <h4 class="text-muted">No Settings Found</h4>
                        <p class="text-muted">Application settings will appear here once configured.</p>
                        <button class="btn btn-primary" onclick="addNewSetting()">
                            <i class="fas fa-plus"></i> Add Setting
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Settings by Category</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @{
                            var categories = Model.Where(s => !string.IsNullOrEmpty(s.Category))
                                                 .GroupBy(s => s.Category)
                                                 .OrderBy(g => g.Key);
                        }
                        @foreach (var category in categories)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card border-light">
                                    <div class="card-header bg-light">
                                        <h6 class="card-title mb-0">
                                            <i class="fas fa-folder"></i> @category.Key
                                        </h6>
                                    </div>
                                    <div class="card-body p-2">
                                        <small class="text-muted">@category.Count() settings</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit Setting Modal -->
<div class="modal fade" id="editSettingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Setting</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editSettingForm">
                    <input type="hidden" id="settingId" />
                    <div class="mb-3">
                        <label for="settingKey" class="form-label">Setting Key</label>
                        <input type="text" class="form-control" id="settingKey" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="settingValue" class="form-label">Value</label>
                        <textarea class="form-control" id="settingValue" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveSetting()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function refreshSettings() {
            location.reload();
        }

        function addNewSetting() {
            alert('Add new setting functionality would be implemented here.');
        }

        $('.edit-setting').on('click', function() {
            var id = $(this).data('id');
            var key = $(this).data('key');
            var value = $(this).data('value');
            
            $('#settingId').val(id);
            $('#settingKey').val(key);
            $('#settingValue').val(value);
            
            $('#editSettingModal').modal('show');
        });

        $('.delete-setting').on('click', function() {
            var key = $(this).data('key');
            if (confirm('Are you sure you want to delete the setting "' + key + '"?')) {
                alert('Delete setting functionality would be implemented here.');
            }
        });

        function saveSetting() {
            var id = $('#settingId').val();
            var value = $('#settingValue').val();
            
            // This would normally make an AJAX call to update the setting
            alert('Save setting functionality would be implemented here.\nSetting ID: ' + id + '\nNew Value: ' + value);
            
            $('#editSettingModal').modal('hide');
        }
    </script>
}
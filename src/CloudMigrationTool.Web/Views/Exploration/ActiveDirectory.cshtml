@model CloudMigrationTool.Web.Models.ActiveDirectoryExplorationViewModel
@{
    ViewData["Title"] = "Active Directory Explorer";
}

<div class="container-fluid">
    <h2 class="mb-4">Active Directory Explorer</h2>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label for="connectionId" class="form-label">Connection</label>
                            <select name="connectionId" id="connectionId" class="form-select" onchange="this.form.submit()">
                                <option value="">-- Select Connection --</option>
                                @foreach (var conn in Model.AvailableConnections)
                                {
                                    <option value="@conn.Id" selected="@(Model.ConnectionId == conn.Id)">@conn.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="searchQuery" class="form-label">Search</label>
                            <input type="text" name="searchQuery" id="searchQuery" class="form-control" value="@Model.SearchQuery" placeholder="Search users, groups, OUs...">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">&nbsp;</label>
                            <div>
                                <button type="submit" class="btn btn-primary">Search</button>
                                <button type="button" class="btn btn-success" onclick="saveSelection()">Save Selection</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsConnected)
    {
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <h5 class="card-title">Total Users</h5>
                        <h3 class="card-text">@Model.TotalUsers</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <h5 class="card-title">Total Groups</h5>
                        <h3 class="card-text">@Model.TotalGroups</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-secondary">
                    <div class="card-body">
                        <h5 class="card-title">Total OUs</h5>
                        <h3 class="card-text">@Model.TotalOUs</h3>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs" id="adTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button">
                    Users <span class="badge bg-secondary">@Model.TotalUsers</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="groups-tab" data-bs-toggle="tab" data-bs-target="#groups" type="button">
                    Groups <span class="badge bg-secondary">@Model.TotalGroups</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="ous-tab" data-bs-toggle="tab" data-bs-target="#ous" type="button">
                    Organizational Units <span class="badge bg-secondary">@Model.TotalOUs</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="adTabContent">
            <div class="tab-pane fade show active" id="users" role="tabpanel">
                <div class="card mt-0 border-top-0">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="selectAllUsers" onchange="toggleAllItems('user')">
                            <label class="form-check-label" for="selectAllUsers">Select All</label>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover" id="usersTable">
                                <thead>
                                    <tr>
                                        <th width="30">
                                            <input type="checkbox" class="form-check-input" id="headerCheckUsers">
                                        </th>
                                        <th>Display Name</th>
                                        <th>UPN</th>
                                        <th>Email</th>
                                        <th>Department</th>
                                        <th>Status</th>
                                        <th>Last Logon</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.Users)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="form-check-input item-checkbox" data-type="user" data-id="@user.UserPrincipalName">
                                            </td>
                                            <td>@user.DisplayName</td>
                                            <td>@user.UserPrincipalName</td>
                                            <td>@user.EmailAddress</td>
                                            <td>@user.Department</td>
                                            <td>
                                                @if (user.Enabled)
                                                {
                                                    <span class="badge bg-success">Enabled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Disabled</span>
                                                }
                                            </td>
                                            <td>@(user.LastLogon?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" onclick="viewUserDetails('@user.UserPrincipalName')">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="groups" role="tabpanel">
                <div class="card mt-0 border-top-0">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="selectAllGroups" onchange="toggleAllItems('group')">
                            <label class="form-check-label" for="selectAllGroups">Select All</label>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover" id="groupsTable">
                                <thead>
                                    <tr>
                                        <th width="30">
                                            <input type="checkbox" class="form-check-input" id="headerCheckGroups">
                                        </th>
                                        <th>Name</th>
                                        <th>Display Name</th>
                                        <th>Type</th>
                                        <th>Scope</th>
                                        <th>Members</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in Model.Groups)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="form-check-input item-checkbox" data-type="group" data-id="@group.Id">
                                            </td>
                                            <td>@group.Name</td>
                                            <td>@group.DisplayName</td>
                                            <td>@group.GroupType</td>
                                            <td>@group.Scope</td>
                                            <td>@group.MemberCount</td>
                                            <td>@(group.Created?.ToString("yyyy-MM-dd") ?? "-")</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" onclick="viewGroupDetails('@group.Id')">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="ous" role="tabpanel">
                <div class="card mt-0 border-top-0">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="selectAllOUs" onchange="toggleAllItems('ou')">
                            <label class="form-check-label" for="selectAllOUs">Select All</label>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover" id="ousTable">
                                <thead>
                                    <tr>
                                        <th width="30">
                                            <input type="checkbox" class="form-check-input" id="headerCheckOUs">
                                        </th>
                                        <th>Name</th>
                                        <th>Distinguished Name</th>
                                        <th>Users</th>
                                        <th>Groups</th>
                                        <th>Computers</th>
                                        <th>Child OUs</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ou in Model.OrganizationalUnits)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="form-check-input item-checkbox" data-type="ou" data-id="@ou.Id">
                                            </td>
                                            <td>@ou.Name</td>
                                            <td>@ou.DistinguishedName</td>
                                            <td>@ou.UserCount</td>
                                            <td>@ou.GroupCount</td>
                                            <td>@ou.ComputerCount</td>
                                            <td>@ou.ChildOUCount</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" onclick="viewOUDetails('@ou.Id')">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.ConnectionId.HasValue)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i> @(ViewBag.ErrorMessage ?? "Failed to connect to Active Directory. Please check your connection settings.")
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Please select a connection to explore Active Directory objects.
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/exploration.js"></script>
}